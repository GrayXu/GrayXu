[Unit]
Description=Publish total-only token usage data branch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=token-heatmap
Group=token-heatmap
Environment=HOME=/var/lib/token-heatmap
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/token-heatmap/src
ExecStart=/usr/bin/python3 -m token_heatmap.app --config /etc/token-heatmap/config.ini sync
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/token-heatmap /var/lib/token-heatmap
